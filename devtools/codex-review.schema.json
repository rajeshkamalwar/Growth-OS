{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Growth OS Codex review result",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "findings"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["pass", "changes_requested"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "findings": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["priority", "title", "detail", "path", "line"],
        "properties": {
          "priority": {
            "type": "string",
            "enum": ["P0", "P1", "P2", "P3"]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "path": {
            "type": ["string", "null"],
            "minLength": 1,
            "maxLength": 500
          },
          "line": {
            "type": ["integer", "null"],
            "minimum": 1,
            "maximum": 1000000
          }
        }
      }
    }
  }
}
